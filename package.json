{
  "name": "kspcid",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "KSPCID — Karnataka Police State Crime Intelligence Dashboard. Build-time ETL compiler (BUILD_SPEC §2.2, §6.4). Nothing here is deployed.",
  "scripts": {
    "etl:audit": "node --import tsx etl/00_audit_data_truth.ts",
    "lint:truth": "node --import tsx etl/lint_data_truth.ts",
    "etl:01": "node --import tsx etl/01_ingest_fir.ts",
    "etl:02": "node --import tsx etl/02_station_crosswalk.ts",
    "etl:03": "node --import tsx etl/03_geo_resolve.ts",
    "etl:04": "node --import tsx etl/04_time_model.ts",
    "etl:05": "node --import tsx etl/05_mo_signature.ts",
    "etl:06": "node --import tsx etl/06_baselines.ts",
    "etl:08:corridor": "node --import tsx etl/08_routing_matrix.ts",
    "etl:08:full": "node --import tsx etl/08_full_routing.ts",
    "etl:08:full:start": "node scripts/start-full-routing.mjs",
    "etl:10:patrol": "node --import tsx etl/10_patrol_fixture.ts",
    "etl:10b:dispatch": "node --import tsx etl/10b_dispatch_routes.ts",
    "etl:12:similarity": "node --import tsx etl/12_similarity_fixture.ts",
    "etl:07:graph": "node --import tsx etl/07_entity_graph.ts",
    "etl:09:graph": "node --import tsx etl/09_compile_graph.ts",
    "etl:a13": "npm run etl:07:graph && npm run etl:09:graph",
    "etl:15:justice": "node --import tsx etl/15_justice_fixture.ts",
    "etl:16:feed": "node --import tsx etl/16_command_feed.ts",
    "etl:17b:cyber": "node --import tsx etl/17b_cyber_fixture.ts",
    "etl:19b:offline": "node --import tsx etl/19b_offline_snapshot.ts",
    "etl:map": "node --import tsx etl/11_command_map_fixture.ts",
    "etl:11:catalyst": "node --import tsx etl/11_publish_catalyst.ts",
    "etl:spine": "node --import tsx etl/audit_demo_spine.ts",
    "verify:adapter": "node --import tsx etl/verify_data_adapter.ts",
    "verify:datastore": "node --import tsx etl/verify_datastore.ts",
    "verify:stratus": "node --import tsx etl/verify_stratus.ts",
    "verify:cloud-plan": "node --import tsx etl/verify_cloud_plan.ts",
    "verify:catalyst-functions": "npm run cloud:functions:build && node --import tsx etl/verify_catalyst_functions.ts",
    "verify:a7": "node --import tsx etl/verify_a7.ts",
    "verify:routing": "node --import tsx etl/verify_routing.ts",
    "verify:patrol": "node --import tsx etl/verify_patrol.ts",
    "verify:similarity": "node --import tsx etl/verify_similarity.ts",
    "verify:graph": "node --import tsx etl/verify_graph.ts",
    "verify:graph:function": "node --import tsx etl/verify_graph_function.ts",
    "verify:justice": "node --import tsx etl/verify_justice.ts",
    "verify:feed": "node --import tsx etl/verify_feed.ts",
    "verify:cyber": "node --import tsx etl/verify_cyber.ts",
    "verify:offline": "node --import tsx etl/verify_offline.ts",
    "verify:map": "node --import tsx etl/verify_command_map.ts",
    "verify:full-routing": "node --import tsx etl/verify_full_routing.ts",
    "typecheck": "tsc --noEmit",
    "verify": "node --import tsx etl/verify_reconciliation.ts",
    "etl:a7": "npm run etl:04 && npm run etl:05 && npm run etl:06",
    "etl:all": "npm run etl:01 && npm run etl:02 && npm run etl:03 && npm run etl:spine && npm run etl:a7",
    "check": "npm run typecheck && npm run lint:truth && npm run verify && npm run verify:adapter && npm run verify:datastore && npm run verify:cloud-plan && npm run verify:catalyst-functions && npm run verify:a7 && npm run verify:routing && npm run verify:full-routing && npm run verify:patrol && npm run verify:similarity && npm run verify:graph && npm run verify:graph:function && npm run verify:justice && npm run verify:feed && npm run verify:cyber && npm run verify:offline && npm run verify:map && npm run check --prefix client",
    "cloud:stratus:validate": "node --import tsx etl/upload_stratus.ts",
    "cloud:nosql:validate": "node --import tsx etl/load_nosql.ts",
    "cloud:cache:validate": "node --import tsx etl/warm_cache.ts",
    "cloud:functions:build": "node --import tsx etl/build_catalyst_functions.ts",
    "donor:refs": "node scripts/prepare-references.mjs",
    "donor:generate": "node scripts/generate-dataset.mjs",
    "donor:validate": "node scripts/validate-dataset.mjs",
    "donor:build": "npm run donor:refs && npm run donor:generate && npm run donor:validate",
    "etl:20:congestion": "node --import tsx etl/20_travel_time_profiles.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.4.0-r.1",
    "@turf/turf": "7.2.0",
    "csv-parse": "6.1.0",
    "csv-stringify": "6.6.0",
    "fast-xml-parser": "^5.10.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "h3-js": "4.2.1",
    "neo4j-driver": "^6.2.0",
    "parquetjs-lite": "0.8.7",
    "uuid": "^11.1.1",
    "zcatalyst-sdk-node": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "5.7.2",
    "zcatalyst-cli": "^1.27.0"
  }
}

{
  "schema_version": 1,
  "environment": "production",
  "notes": [
    "Production is mandatory: Catalyst development allows only 5,000 rows per table and 25,000 rows per project.",
    "Catalyst exposes unique constraints and Search Index constraints in Data Store schema. The official Data Store documentation does not expose general secondary-index DDL; query_filter_columns records the required access paths for confirmation with Catalyst support.",
    "act_section is Text because 191 source values exceed Var Char's 255-character limit. Three lossless Var Char chunks carry the Catalyst Search indexes."
  ],
  "tables": {
    "Stations": {
      "scope": "Global",
      "source": "data/derived/stations.parquet",
      "expected_rows": 178,
      "columns": {
        "station_code": { "type": "Var Char", "max_length": 24, "mandatory": true, "unique": true },
        "station_name": { "type": "Var Char", "max_length": 64, "mandatory": true },
        "police_division": { "type": "Var Char", "max_length": 32 },
        "subdivision": { "type": "Var Char", "max_length": 32 },

        "window_observations": { "type": "Int", "mandatory": true },
        "source_authority": { "type": "Var Char", "max_length": 32, "mandatory": true },
        "transformation": { "type": "Var Char", "max_length": 16, "mandatory": true },
        "method": { "type": "Var Char", "max_length": 64, "mandatory": true },
        "source_checksum": { "type": "Var Char", "max_length": 64, "mandatory": true },
        "generation_version": { "type": "Var Char", "max_length": 32, "mandatory": true }
      },
      "query_filter_columns": ["station_code", "crime_head", "iso_week", "week_start"]

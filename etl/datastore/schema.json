        "is_territorial": { "type": "Boolean", "mandatory": true },
        "coverage": { "type": "Var Char", "max_length": 32, "mandatory": true },
        "unit_count": { "type": "Int", "mandatory": true },
        "fir_count": { "type": "Int", "mandatory": true }
      },
      "query_filter_columns": ["station_code", "is_territorial"]
    },
